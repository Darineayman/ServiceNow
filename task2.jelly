<?xml version="1.0" encoding="utf-8"?>

<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
    crossorigin="anonymous"></link> -->

  <j:new className="java.util.HashMap" var="employee" />
  <j:new className="java.util.Date" var="myDate"/>
  <j:new className="java.util.ArrayList" var="employees" />


  <j:new className="java.text.SimpleDateFormat" var="formatter">
    <j:arg value="yyyy-MM-dd HH:mm:ss" />
  </j:new>

  <j:invoke on="${formatter}" method="parse" var="parsedData">
    <j:arg value="2026-02-24 15:30:00"></j:arg>
  </j:invoke>
  <p>${parsedData}</p>

  <j:invoke on="${formatter}" method="format" var="formatteddata">
    <j:arg value="${parsedData}"></j:arg>
  </j:invoke>
  <p>${formatteddata}</p>


</j:jelly>